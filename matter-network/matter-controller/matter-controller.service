[Unit]
Description=Matter Controller Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/iot-system/matter-network/matter-controller
Environment="PATH=usr/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/npx tsx --env-file=.env src/index.ts
Restart=on-failure
RestartSec=5
Environment="FORCE_COLOR=1"
Environment="MATTER_LOG_FORMAT=ansi"

[Install]
WantedBy=multi-user.target